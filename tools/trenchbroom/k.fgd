// Entity definitions for TrenchBroom. Keys mirror Source where it makes sense.

@SolidClass = worldspawn : "The world"
[
    message(string) : "Map title"
    skyname(string) : "Sky cubemap (materials/skybox/<name>_px.png ...)" : "sky_day"
    _minlight(integer) : "Minimum light level (0-255)" : 0
]

@SolidClass = func_detail : "Detail brush: solid and drawn, but doesn't split the BSP or block visibility. Use for small props, trim and furniture." []

@PointClass size(-16 -16 0, 16 16 72) color(0 255 0) = info_player_start : "Player spawn point"
[
    angles(string) : "Pitch Yaw Roll" : "0 0 0"
]

@PointClass size(-8 -8 -8, 8 8 8) color(255 255 0) = light : "Point light"
[
    _light(color255) : "Color (R G B) and brightness" : "255 255 255 200"
]

@PointClass size(-16 -16 -16, 16 16 16) color(255 200 0) = light_environment : "Sun and sky light. Only one per map."
[
    angles(string) : "Sun yaw (pitch comes from the pitch key)" : "0 0 0"
    pitch(integer) : "Sun pitch: -90 is straight overhead" : -45
    _light(color255) : "Sun color and brightness" : "255 255 255 200"
    _ambient(color255) : "Sky ambient color and brightness" : "150 175 215 60"
]

@PointClass size(-16 -16 0, 16 16 32) color(200 150 100) model({ "path": model, "scale": modelscale }) = prop_static : "Static model (glTF .glb)"
[
    model(studio) : "Model path" : "models/props/crate.glb"
    angles(string) : "Pitch Yaw Roll" : "0 0 0"
    modelscale(float) : "Scale" : "1"
]

// ---- Brush entities ---------------------------------------------------------------------

@BaseClass = Targetname [ targetname(target_source) : "Name" ]

@SolidClass base(Targetname) = func_door : "Door, elevator or platform: slides along movedir by its size minus lip."
[
    movedir(string) : "Move direction (pitch yaw roll); -90 0 0 = up" : "0 0 0"
    speed(integer) : "Speed (units/sec)" : 100
    wait(float) : "Seconds before returning (-1 = stay)" : 4
    lip(integer) : "Lip: units left showing (negative = travel further)" : 0
    locked(choices) : "Locked" : 0 = [ 0 : "No" 1 : "Yes" ]
    spawnflags(flags) = [ 256 : "Use opens" : 0 ]
    OnOpen(output) : "Started opening"
    OnClose(output) : "Started closing"
    OnFullyOpen(output) : "Reached the open position"
    OnFullyClosed(output) : "Reached the closed position"
    OnLockedUse(output) : "Used while locked"
    OnBlocked(output) : "Something is in the way"
]

@SolidClass base(Targetname) = func_button : "Pressed with +use."
[
    movedir(string) : "Press direction" : "0 0 0"
    wait(float) : "Seconds before it pops back out" : 1
    locked(choices) : "Locked" : 0 = [ 0 : "No" 1 : "Yes" ]
    OnPressed(output) : "Pressed"
    OnIn(output) : "Fully pressed in"
    OnOut(output) : "Back out"
    OnUseLocked(output) : "Used while locked"
]

@SolidClass base(Targetname) = trigger_multiple : "Fires when the player enters. Use tools/toolstrigger."
[
    wait(float) : "Seconds between OnTrigger fires" : 1
    StartDisabled(choices) : "Start disabled" : 0 = [ 0 : "No" 1 : "Yes" ]
    OnStartTouch(output) : "Player entered"
    OnEndTouch(output) : "Player left"
    OnTrigger(output) : "Player entered (respects wait)"
]

@SolidClass base(Targetname) = trigger_once : "Fires once, then removes itself."
[
    OnTrigger(output) : "Player entered"
]

@SolidClass base(Targetname) = trigger_hurt : "Hurts players inside it."
[
    damage(integer) : "Damage per second" : 10
]

@SolidClass base(Targetname) = trigger_teleport : "Teleports the player to the named destination."
[
    target(target_destination) : "Destination (info_teleport_destination)"
]

@SolidClass base(Targetname) = func_brush : "A brush that can be hidden and made non-solid."
[
    StartDisabled(choices) : "Start disabled" : 0 = [ 0 : "No" 1 : "Yes" ]
    Solidity(choices) : "Solidity" : 0 = [ 0 : "When visible" 1 : "Never" 2 : "Always" ]
]

@SolidClass base(Targetname) = func_wall : "A solid brush entity (no BSP split)." []
@SolidClass base(Targetname) = func_illusionary : "Visible but never solid." []

// ---- Logic ---------------------------------------------------------------------------------

@PointClass base(Targetname) color(0 200 255) size(-8 -8 -8, 8 8 8) = logic_relay : "Fires OnTrigger when it receives Trigger."
[
    StartDisabled(choices) : "Start disabled" : 0 = [ 0 : "No" 1 : "Yes" ]
    spawnflags(flags) = [ 1 : "Only trigger once" : 0 ]
    OnTrigger(output) : "Triggered"
    OnSpawn(output) : "Map started"
]

@PointClass base(Targetname) color(0 200 255) size(-8 -8 -8, 8 8 8) = logic_timer : "Fires OnTimer every RefireTime seconds."
[
    RefireTime(float) : "Interval (seconds)" : 1
    StartDisabled(choices) : "Start disabled" : 0 = [ 0 : "No" 1 : "Yes" ]
    OnTimer(output) : "Timer fired"
]

@PointClass color(0 200 255) size(-8 -8 -8, 8 8 8) = logic_auto : "Fires OnMapSpawn when the map starts."
[
    OnMapSpawn(output) : "Map started"
]

@PointClass base(Targetname) color(0 200 255) size(-8 -8 -8, 8 8 8) = math_counter : "Integer counter with limits."
[
    startvalue(integer) : "Start value" : 0
    min(integer) : "Minimum" : 0
    max(integer) : "Maximum" : 0
    OnHitMax(output) : "Reached max"
    OnHitMin(output) : "Reached min"
    OutValue(output) : "Value changed (value as parameter)"
]

@PointClass base(Targetname) color(255 255 255) size(-8 -8 -8, 8 8 8) = point_message : "Shows a message (inputs ShowMessage, ShowHudMessage)."
[
    message(string) : "Message"
]

@PointClass base(Targetname) color(200 200 200) size(-8 -8 -8, 8 8 8) = info_target : "A named position." []
@PointClass base(Targetname) color(200 200 200) size(-16 -16 0, 16 16 72) = info_teleport_destination : "Teleport destination."
[
    angles(string) : "Facing (pitch yaw roll)" : "0 0 0"
]

@PointClass base(Targetname) color(200 150 100) model({ "path": model }) size(-16 -16 0, 16 16 32) = prop_dynamic : "A model the game can show/hide (TurnOn/TurnOff)."
[
    model(studio) : "Model path"
    angles(string) : "Pitch Yaw Roll" : "0 0 0"
]

// ---- Physics and sound ------------------------------------------------------------------

@PointClass base(Targetname) color(220 160 90) model({ "path": model }) size(-16 -16 0, 16 16 32) = prop_physics : "A physics model: falls, can be pushed, picked up (+use) and thrown (+attack)."
[
    model(studio) : "Model path" : "models/props/crate.glb"
    angles(string) : "Pitch Yaw Roll" : "0 0 0"
    massScale(float) : "Mass multiplier" : "1"
]

@PointClass base(Targetname) color(120 200 255) size(-8 -8 -8, 8 8 8) = ambient_generic : "Plays a sound script here (loops if the script loops)."
[
    message(sound) : "Sound script name" : "Ambient.Hum"
    health(integer) : "Volume (0-10)" : 10
    spawnflags(flags) = [ 16 : "Start silent" : 0 ]
]
